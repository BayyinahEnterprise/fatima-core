      "atom-0001": {
        "atom_id": "atom-0001",
        "content": "\\vspace{1em}",
        "content_type": "proposition",
        "content_hash": "d84b77dfd8700c584a53df5b9b32db72be3b7137e1faba40ea6d363346e78e35",
        "semantic_hash": "cd705720a840f4513d250cbb79b30df32bfa73c768cabd0044f32bd1f3799427",
